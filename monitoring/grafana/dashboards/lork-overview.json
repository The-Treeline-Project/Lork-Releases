    {
      "title": "Authentication results per minute",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "One result per authentication request, including cancellation. These are not internal retry counts.",
      "targets": [
        {
          "expr": "sum by (job, instance, status) (rate(lork_auth_results_total{job=~\"$job\",instance=~\"$instance\"}[$__rate_interval])) * 60",
          "legendFormat": "{{job}} / {{instance}} {{status}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "range": true,
          "instant": false
