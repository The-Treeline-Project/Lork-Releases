        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "1 while a Cion batch is running; 0 when idle.",
      "targets": [
        {
          "expr": "lork_cion_busy{job=~\"$job\",instance=~\"$instance\"}",
