      },
      "description": "Seconds since this Lork process started. Restarting the process resets this gauge.",
      "targets": [
        {
          "expr": "lork_uptime_seconds{job=~\"$job\",instance=~\"$instance\"}",
          "legendFormat": "{{job}} / {{instance}}",
