    {
      "title": "Authentication success rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "SUCCESS / completed non-cancelled auths, computed separately per instance. INVALID and BANNED count as unsuccessful. No traffic produces no percentage.",
      "targets": [
        {
          "expr": "100 * sum by (job, instance) (rate(lork_auth_results_total{job=~\"$job\",instance=~\"$instance\",status=\"SUCCESS\"}[$__rate_interval])) / sum by (job, instance) (rate(lork_auth_results_total{job=~\"$job\",instance=~\"$instance\",status!=\"CANCELLED\"}[$__rate_interval]))",
          "legendFormat": "{{job}} / {{instance}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "range": true,
          "instant": false
        }
