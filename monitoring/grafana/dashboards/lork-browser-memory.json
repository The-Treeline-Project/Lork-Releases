    {
      "title": "Cleanup failures / fenced browsers",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Current quarantined/fenced browser count, not a lifetime failure counter. A fenced instance cannot be returned to the pool until cleanup is confirmed.",
      "targets": [
        {
          "expr": "lork_browser_cleanup_failures{job=~\"$job\",instance=~\"$instance\"}",
          "legendFormat": "{{job}} / {{instance}} {{role}}",
          "refId": "A",
