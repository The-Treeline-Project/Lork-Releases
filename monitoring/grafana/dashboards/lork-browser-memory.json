    {
      "title": "Container memory events per minute",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Kernel cgroup v2 events, such as high, max, oom and oom_kill. An oom event is not necessarily a kill.",
      "targets": [
        {
          "expr": "rate(lork_container_memory_events_total{job=~\"$job\",instance=~\"$instance\"}[$__rate_interval]) * 60",
          "legendFormat": "{{job}} / {{instance}} {{event}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
